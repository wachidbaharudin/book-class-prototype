# Local development environment template.
#
# Copy to .env (`cp .env.example .env`) and fill in real values locally.
# .env is git-ignored. This file uses PLACEHOLDERS ONLY — never commit real
# credentials, keys, or personal data.

# Runtime mode for the api/web processes. Use "development" locally.
NODE_ENV=development

# --- Database: docker-compose.dev.yml `db` service --------------------------
# Bootstrap credentials for the local Postgres 16 container. Local-only values.
POSTGRES_USER=bookclass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookclass
# Host port published for host-run tooling (drizzle-kit, psql).
POSTGRES_PORT=5433

# --- Application connection string ------------------------------------------
# Host-run tools connect via localhost. The api container overrides this with
# the compose-internal host `db`, so both can share one .env.
DATABASE_URL=postgresql://bookclass:change-me@localhost:5433/bookclass

# --- Published app ports ----------------------------------------------------
API_PORT=4000
WEB_PORT=3001

# --- Secrets (placeholders only) --------------------------------------------
# 32-byte base64 key for the AES-256-GCM encryption of
# centers.midtrans_server_key_enc (ENG-00 XD-9 / §3).
APP_ENCRYPTION_KEY=your-32-byte-base64-key-here
# Midtrans Core API credentials. Sandbox by default; live is a config/keys flip.
MIDTRANS_CLIENT_KEY=your-midtrans-client-key-here
MIDTRANS_SERVER_KEY=your-midtrans-server-key-here
MIDTRANS_IS_PRODUCTION=false

# --- Email ------------------------------------------------------------------
# SMTP DSN used by the Mailer port outside production (ENG-09).
MAILER_DSN=your-mailer-dsn-here

# --- Production deployment (docker-compose.yml) -----------------------------
# Public hostname Caddy serves and requests a certificate for.
DOMAIN=localhost
# Nightly backup job (scripts/backup.sh). RCLONE_REMOTE is optional but the
# off-host copy is what makes backups real; see docs/ops/deployment.md.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# RCLONE_REMOTE=r2:bookclass-backups
