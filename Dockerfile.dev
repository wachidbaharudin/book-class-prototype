# Shared development image: Node 22 + pnpm. Application source is bind-mounted by
# docker-compose.dev.yml, so this image deliberately contains no app code.
FROM node:22-alpine

RUN apk add --no-cache libc6-compat \
 && npm install -g pnpm@10.17.1 \
 && pnpm config set store-dir /pnpm-store --global

WORKDIR /workspace
CMD ["sh"]
